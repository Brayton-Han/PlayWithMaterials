# 复制为 .env 后按需修改。仓库中只保存示例值，不含真实凭据。
# docker compose 会自动读取根目录的 .env。

# ---------- MySQL（docker-compose.dev.yml / docker-compose.yml） ----------
MYSQL_DATABASE=xiaoying
MYSQL_USER=xiaoying
MYSQL_PASSWORD=xiaoying
MYSQL_ROOT_PASSWORD=root
# 本地映射端口（dev compose）。默认 3307，避免与本机已安装的 MySQL 冲突
MYSQL_PORT=3307

# ---------- 后端（Spring Boot，环境变量覆盖 application.yml） ----------
# dev profile 默认连接 jdbc:mysql://localhost:3307/xiaoying
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3307/xiaoying?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=xiaoying
DB_PASSWORD=xiaoying
# 上传与结果文件根目录（dev 默认 ./data/storage，容器内 /data/storage）
APP_STORAGE_ROOT=./data/storage

# ---------- 前端（Next.js） ----------
# rewrites 目标：/api/** 与 /files/** 转发到这里；standalone 构建时在构建期写入
BACKEND_INTERNAL_URL=http://localhost:8080
