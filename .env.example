# 复制为 .env 后按需修改（docker compose 会自动读取根目录的 .env）。
# 仓库中只保存示例值，不含真实凭据。所有服务都在 Docker 中运行：
#   开发：docker compose -f docker-compose.dev.yml up --build
#   演示：docker compose up --build

# ---------- MySQL ----------
MYSQL_DATABASE=xiaoying
MYSQL_USER=xiaoying
MYSQL_PASSWORD=xiaoying
MYSQL_ROOT_PASSWORD=root

# ---------- 宿主机端口映射 ----------
FRONTEND_PORT=3000
BACKEND_PORT=8080
# 仅开发环境映射 MySQL；默认 3307，避免与本机已安装的 MySQL 冲突
MYSQL_PORT=3307

# ---------- 镜像 ----------
# 演示环境镜像 tag（xiaoying-backend:<tag>、xiaoying-frontend:<tag>），用于回滚到上一个版本
IMAGE_TAG=latest

# ---------- 以下由 compose 注入容器，一般无需修改 ----------
# 后端（Spring Boot 环境变量覆盖 application.yml）：
#   SPRING_PROFILES_ACTIVE  dev（开发 compose）/ demo（演示 compose）
#   DB_URL / DB_USERNAME / DB_PASSWORD  指向 mysql 服务
#   APP_STORAGE_ROOT=/data/storage      上传与结果文件根目录（数据卷）
# 前端：
#   BACKEND_INTERNAL_URL=http://backend:8080   rewrites 目标（演示镜像在构建期写入）
